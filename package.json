{
  "name": "github-portfolio-blog",
  "version": "1.0.0",
  "description": "GitHub Pages 개인 포트폴리오 & 기술 블로그",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "new-post": "node scripts/new-post.js",
    "deploy": "node scripts/deploy.js",
    "audit:perf": "npx lighthouse http://localhost:3000 --view --output=html",
    "audit:a11y": "npx @axe-core/cli http://localhost:3000",
    "format": "npx prettier --write \"**/*.{html,css,js,json,md}\"",
    "tistory:convert": "node Tstory_/scripts/md_to_tistory_html.js",
    "tistory:draft": "node Tstory_/scripts/upload_draft.js",
    "tistory:auto": "node Tstory_/scripts/tistory_auto_manager.js all",
    "tistory:cdp": "node Tstory_/scripts/cdp_tistory_operator.js all"
  },
  "keywords": [
    "portfolio",
    "blog",
    "github-pages",
    "markdown"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.63.0"
  }
}
